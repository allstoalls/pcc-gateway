+            ir.Constant(_I64, 1),
+            ir.Constant(_I32, _PY_TYPE_FLOAT),
+            ir.Constant(_I32, _PY_FLAG_IMMORTAL),
+            ir.Constant(ir.DoubleType(), value),
+        ],
+    )
+    pool[bits] = gv
+    return gv
